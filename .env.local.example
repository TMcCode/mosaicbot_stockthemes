# Copy to .env.local (not committed).

# Public R2 custom domain (default in code). The stockthemes-public bucket is the only public bucket.
NEXT_PUBLIC_STOCKTHEMES_MANIFEST_URL=https://storage.stockthemes.ai/manifest.json

# Optional authenticated R2 cache warm for local builds.
# GitHub Actions should set these as repository secrets, not as NEXT_PUBLIC_* vars.
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<access-key-id>
# R2_SECRET_ACCESS_KEY=<secret-access-key>
# STOCKTHEMES_SYNC_VIA_R2=1

# Non-secret bucket/base defaults live in:
# - scripts/lib/storageConfig.mjs
# - src/lib/stockthemesStorageConfig.ts

# Production Pages build sets this; local prod-like test:
# NEXT_PUBLIC_STOCKTHEMES_DISABLE_LIVE_HYDRATE=1

# Commentary-only live fetch from R2 (on by default when manifest URL is set).
# Fetches home_commentary.v0.json in the browser every ~5 min; theme JSON stays static.
# NEXT_PUBLIC_STOCKTHEMES_COMMENTARY_LIVE=0  # disable
# NEXT_PUBLIC_STOCKTHEMES_COMMENTARY_REVALIDATE_SEC=300
# Deprecated direct GCS fallback from the previous storage backend:
# https://storage.googleapis.com/stockthemes-public/manifest.json

# Optional override for fuzzy search index (defaults to <manifest-dir>/search_index.v0.json)
# NEXT_PUBLIC_STOCKTHEMES_SEARCH_INDEX_URL=https://storage.stockthemes.ai/search_index.v0.json

# Offline / fixture-only: npm run dev with fixtures instead of default public bucket
# STOCKTHEMES_USE_FIXTURES=1

# Dev speed: cache public JSON under .cache/stockthemes-public/ for 120s (layout manifest, /my compare, etc.).
# Run once: node scripts/sync-build-cache.mjs  (or let the first dev page load populate the cache).
# STOCKTHEMES_DEV_REVALIDATE_SEC=120
# Fast UI dev (default): omit STOCKTHEMES_DEV_VIA_GCS — CDN + .cache/stockthemes-public/ (120s).
# Fresh ETL after manifest: STOCKTHEMES_DEV_VIA_R2=1 (disk cache default 600s between R2 hits).
# STOCKTHEMES_DEV_VIA_R2=1
# Homepage also loads home_top_movers.v0.json (pre-ranked marquee) and home_trending.v0.json (trending table).
# STOCKTHEMES_DEV_GCS_STRICT=1  # compatibility alias; throw if R2 fails (default: fall back to .cache then public URL)
# Warm disk cache before dev: npm run dev:cache
# Fresh ETL data: STOCKTHEMES_DEV_NO_STORE=1  (always hit CDN) or delete .cache/stockthemes-public/

# Build + browser cache window for public GCS JSON (seconds). Default 7200 = 120 minutes.
# STOCKTHEMES_REVALIDATE_SEC=7200

# Canonical site origin for sitemap.xml, robots.txt, and metadata (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://stockthemes.ai

# Supabase (optional) — magic-link sign-in + watchlist storage. Omit to hide auth UI on static hosts.
# Project URL + anon (public) key from Supabase Dashboard → Settings → API.
# Add the same NEXT_PUBLIC_* vars to GitHub Actions for production Pages builds.
# Redirect URLs in Supabase (Auth → URL): http://localhost:3000/auth/callback and https://stockthemes.ai/auth/callback
# (include base path if using GitHub project Pages: https://<user>.github.io/<repo>/auth/callback)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Beehiiv — API signup (Next.js route; needs Node/serverless; not GitHub Pages). Used only if no embed URL above.
# Publication ID: Settings → API (prefixed id, e.g. pub_…)
# API key: Settings → API (requires API access on your Beehiiv plan)
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=
# CI for GitHub Pages sets STOCKTHEMES_STATIC_PAGES=1 so API signup stays off even if keys exist.

# Theme / group suggestions (/account/suggest): Supabase ledger + email via FormSubmit.co (static Pages OK).
# Run supabase/migrations/003_theme_idea_submissions.sql in the Supabase SQL editor.
# First deploy: FormSubmit sends a one-time activation link to themeideas@stockthemes.ai — click it before testing.
# Admins: set status to accepted/rejected and published_theme_slug when a suggestion ships (Dashboard → Table Editor).

# Beehiiv — iframe (works on static GitHub Pages). Set as GitHub Actions Variables for deploy-pages.yml
# Single form (both themes): only NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_FORM_URL
# Two themed forms: set BOTH _LIGHT and _DARK (iframe src swaps with the site theme; embed.js + attribution.js are shared)
# NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_FORM_URL=https://subscribe-forms.beehiiv.com/your-form-uuid
# NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_FORM_URL_LIGHT=https://subscribe-forms.beehiiv.com/your-light-form-uuid
# NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_FORM_URL_DARK=https://subscribe-forms.beehiiv.com/your-dark-form-uuid
# Optional narrow viewports (≤640px): when both are set, they replace LIGHT/DARK for the footer embed.
# NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_FORM_URL_MOBILE_LIGHT=https://subscribe-forms.beehiiv.com/your-mobile-light-uuid
# NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_FORM_URL_MOBILE_DARK=https://subscribe-forms.beehiiv.com/your-mobile-dark-uuid

# Google AdSense (optional). Create display units in AdSense; one slot id per placement below.
# Before revenue: add public/ads.txt on the live apex domain (see AdSense → Sites → ads.txt).
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_HERO=
# NEXT_PUBLIC_ADSENSE_SLOT_THEME_RAIL=
# NEXT_PUBLIC_ADSENSE_SLOT_GROUP_RAIL=
# NEXT_PUBLIC_ADSENSE_SLOT_GROUP_STRIP=
# All groups index (/groups): rail in hero + horizontal strip below intro (replaces old mid-list strips).
# NEXT_PUBLIC_ADSENSE_SLOT_GROUPS_INDEX_RAIL=
# NEXT_PUBLIC_ADSENSE_SLOT_GROUPS_INDEX_STRIP=
# All themes index (/themes): rail in hero + horizontal strip (same slot id) after every 50 themes in the list.
# NEXT_PUBLIC_ADSENSE_SLOT_THEMES_INDEX_RAIL=
# NEXT_PUBLIC_ADSENSE_SLOT_THEMES_INDEX_STRIP=
# Optional home/theme placements (create matching Display units in AdSense). Leave unset to hide a slot.
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_DISCOVERY_MID=
# NEXT_PUBLIC_ADSENSE_SLOT_THEME_CHART_END=
