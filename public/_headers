# Cloudflare Pages headers for the static Next export.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Brand PNGs/SVGs are also cache-busted via brandAssetPath() (?v=…) in siteUrl.ts.
# Bump BRAND_ASSET_VERSION whenever you replace logo files.
/brand/*
  Cache-Control: public, max-age=3600, must-revalidate
